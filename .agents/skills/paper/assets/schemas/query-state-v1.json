{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-query-state-v1",
  "title": "Persistent actual research retrieval and selection state",
  "type": "object",
  "required": ["format", "trace_id", "created_at", "updated_at", "question", "scope", "mode", "criteria_history", "records", "events", "citation_edges", "stop"],
  "properties": {
    "format": {"const": "paper-query-v1"},
    "trace_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "created_at": {"type": "string"}, "updated_at": {"type": "string"},
    "question": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1},
    "mode": {"enum": ["local", "lineage", "systematic"]},
    "criteria_history": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["at", "scope", "include", "exclude", "budget", "reason"], "properties": {
      "at": {"type": "string"}, "scope": {"type": "string"}, "include": {"type": "array", "items": {"type": "string"}},
      "exclude": {"type": "array", "items": {"type": "string"}}, "budget": {"type": "string"}, "reason": {"type": "string"}
    }}},
    "records": {"type": "object", "additionalProperties": {"type": "object", "required": ["record_id", "provider", "observed_at", "event_id", "item_index", "work_id", "report_id", "version", "study_id", "metadata_sha256", "identity_aliases", "screening"], "properties": {
      "record_id": {"type": "string"}, "provider": {"enum": ["arxiv", "crossref", "openalex", "manual"]},
      "observed_at": {"type": "string"}, "event_id": {"type": "string"}, "item_index": {"type": "integer", "minimum": 0},
      "work_id": {"type": "string"}, "report_id": {"type": "string"}, "version": {"type": ["string", "null"]},
      "study_id": {"type": ["string", "null"]}, "metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "identity_aliases": {"type": "array", "items": {"type": "string"}},
      "screening": {"type": "object", "required": ["status", "reason", "history"], "properties": {
        "status": {"enum": ["纳入", "排除", "待判断"]}, "reason": {"type": "string"}, "history": {"type": "array", "items": {"type": "object"}}
      }}
    }}},
    "events": {"type": "object", "additionalProperties": {"type": "object", "required": ["path", "kind", "observed_at", "status", "record_ids", "event_sha256"], "properties": {
      "path": {"type": "string"}, "kind": {"enum": ["search", "import", "screen", "expand"]}, "observed_at": {"type": "string"},
      "status": {"enum": ["complete", "partial", "failed"]}, "record_ids": {"type": "array", "items": {"type": "string"}},
      "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }}},
    "citation_edges": {"type": "array", "items": {"type": "object", "required": ["id", "source", "target", "type", "event_id", "location", "raw_path", "raw_sha256", "observed_at"], "properties": {
      "id": {"type": "string"}, "source": {"type": "string"}, "target": {"type": "string"}, "type": {"const": "cites"},
      "event_id": {"type": "string"}, "location": {"type": "string"}, "raw_path": {"type": "string"},
      "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "observed_at": {"type": "string"}
    }}},
    "stop": {"type": ["object", "null"]}
  }
}
