{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-semantic-impact-v1",
  "title": "Persistent review candidates; never automatic scientific verdict updates",
  "type": "object",
  "required": ["format", "created_at", "previous_snapshot", "current_snapshot", "changed_objects", "source_changes", "candidates"],
  "properties": {
    "format": {"const": "paper-semantic-impact-v1"},
    "created_at": {"type": "string"},
    "previous_snapshot": {"type": ["string", "null"]},
    "current_snapshot": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changed_objects": {"type": "object", "additionalProperties": {"type": "object", "required": ["before", "after"], "properties": {"before": {"type": ["string", "null"]}, "after": {"type": ["string", "null"]}}}},
    "source_changes": {"type": "array", "items": {"type": "string"}},
    "candidates": {"type": "array", "items": {
      "type": "object",
      "required": ["key", "status", "reasons", "note_sha256"],
      "properties": {
        "key": {"type": "string"},
        "status": {"enum": ["待处理", "已核", "需修订", "不变"]},
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "note_sha256": {"type": ["string", "null"]},
        "history": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
        "resolution": {"$ref": "#/$defs/decision"}
      }
    }}
  },
  "$defs": {
    "decision": {"type": "object", "required": ["at", "decision", "reason", "evidence", "note_sha256"], "properties": {
      "at": {"type": "string"}, "decision": {"enum": ["待处理", "已核", "需修订", "不变"]},
      "reason": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "string"}},
      "note_sha256": {"type": ["string", "null"]}
    }}
  }
}
